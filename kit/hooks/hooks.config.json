{
  "hooks": {
    "protect-sensitive-files": "block",
    "block-secrets-in-writes": "block",
    "redact-prompt-secrets": "block",
    "guard-dangerous-commands": "block",
    "protect-paths": "block",
    "protect-branches": "block",
    "clean-commit-message": "block",
    "audit-reminder": "warn",
    "artifact-header": "warn",
    "require-spec": "warn",
    "post-edit-quality": "warn",
    "warn-secret-output": "warn",
    "session-context": "warn",
    "verify-on-stop": "off",
    "audit-log": "off",
    "commit-checkpoint": "warn"
  },
  "sensitive": { "extraFiles": [], "allow": [], "extraEnvKeywords": [] },
  "secrets": { "extraPatterns": [] },
  "commands": { "extraDeny": [], "allow": [] },
  "protect": { "paths": [] },
  "spec": { "exempt": [] },
  "quality": { "format": "", "lint": "", "timeoutSec": 60 },
  "verify": { "command": "", "timeoutSec": 300 },
  "branches": { "protected": [] },
  "commit": { "maxUncommittedFiles": 8, "extraForbiddenText": [] },
  "audit": { "file": ".light-kit/audit.log", "remind": true }
}
